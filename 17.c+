class Solution {
public:
    vector<string> result;

    void backtrack(string digits, int i, string temp, vector<string>& mp) {
        if (i == digits.length()) {
            result.push_back(temp);
            return;
        }

        string letters = mp[digits[i] - '0'];

        for (int j = 0; j < letters.length(); j++) {
            backtrack(digits, i + 1, temp + letters[j], mp);
        }
    }

    vector<string> letterCombinations(string digits) {
        if (digits.empty())
            return {};

        vector<string> mp = {
            "", "", "abc", "def", "ghi",
            "jkl", "mno", "pqrs", "tuv", "wxyz"
        };

        backtrack(digits, 0, "", mp);

        return result;
    }
};